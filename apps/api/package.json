{
  "name": "@agent-frame/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --watch ../../packages/shared/src --ext ts,json --exec \"bun run src/server.ts\"",
    "start": "bun run src/server.ts",
    "lint": "eslint . --max-warnings=0",
    "tsc-check": "tsc -p tsconfig.check.json --noEmit",
    "typecheck": "bun run tsc-check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:init": "bun run scripts/db-init.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@agent-frame/shared": "workspace:*",
    "@ai-sdk/anthropic": "3.0.81",
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/openai": "^1.3.24",
    "@elysiajs/cors": "^1.3.0",
    "ai": "^6.0.193",
    "drizzle-orm": "^0.44.0",
    "elysia": "^1.3.0",
    "ioredis": "^5.11.0",
    "jose": "^6.2.3",
    "mysql2": "^3.14.0",
    "ulid": "^2.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.2.0",
    "@types/ioredis": "^5.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "nodemon": "^3.1.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.2"
  }
}
